# Derived course media that belongs in the private delivery system
*.pdf
*.mp4
*.mov
*.mkv
*.avi
*.wav
*.m4a
*.mp3
*.srt
*.vtt

# Whisper transcripts and caption data derived from the private narration
# recordings. Only a numbers-only timing derivative such as
# narration-timing.json may be published.
transcript.*
*.transcript.*
transcript/
transcripts/
caption/
captions/
caption.json
captions.json

# Licensed local font binaries (style references may remain in code)
*.ttf
*.ttc
*.otf
*.woff
*.woff2

# Raster/vector exports can reproduce confidential presentation slides
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.bmp
*.tif
*.tiff
*.avif
*.svg

# Archives can conceal blocked source material
*.zip
*.7z
*.rar
*.tar
*.tgz
*.gz
*.bz2
*.xz

# Known private planning-source naming pattern
AutoCAD_Technician_Video_Course_MasterPlan_*.html

# Private-only working directories
private/
_private/
private-materials/
source-materials/
raw-materials/
local-materials/
course-source/
private-work/

# HyperFrames local preview cache
.thumbnails/
.hyperframes/
snapshots/

# Local JavaScript dependencies used by preview and QA tooling
node_modules/

# Local Python environment for the narration transcription tooling. Installed
# packages record absolute install paths and file:// URIs that the content guard
# blocks, so this directory must never become tracked.
.venv/
__pycache__/
*.pyc

# The bracket model is the course author's own work, cleared for publication.
# Everything else matching those extensions stays blocked.
!model/
!model/**

# Explicitly reviewed public AutoCAD course artifacts. Keep the global image and
# planning-source blocks above; only these exact deliverable paths are public.
!projects/autocad-technician/lesson-*/snapshots/
!projects/autocad-technician/lesson-*/snapshots/**
!docs/autocad-technician/reference/a3-landscape-template-reference.png
!docs/autocad-technician/master-plan/AutoCAD_Technician_Video_Course_MasterPlan_260811.html

# Absolute paths to private recordings, written by scripts/part/ingest_recording.py
media.local.json

# Full Korean/English comparison export for the English reviewer. Roughly 900 KB
# and entirely derivable from scripts/selfstudy/source/, so it is regenerated on
# demand rather than tracked: python scripts/selfstudy/bilingual_review.py
docs/autocad-technician/self-study/bilingual-review.csv

# The whole course rebuilt as one shareable page. About 1.1 MB and entirely
# derivable, so it is generated when someone needs a single link rather than
# tracked: python scripts/selfstudy/build_single.py
docs/autocad-technician/self-study/autocad-self-study-all-in-one.html
