*.ppsm
*.pot
*.potx
*.potm
*.odp
~$*

# AutoCAD source and recovery files
*.dwg
*.dxf
*.dwt
*.dws
*.sv$
*.ac$
*.dwl
*.dwl2

# 3D CAD sources and neutral exchange files. The bracket is modelled before it is
