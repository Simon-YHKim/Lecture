#!/usr/bin/env sh

if command -v pwsh >/dev/null 2>&1; then
  exec pwsh -NoProfile -File scripts/check-private-materials.ps1 -Mode staged
fi

if command -v powershell.exe >/dev/null 2>&1; then
  exec powershell.exe -NoProfile -File scripts/check-private-materials.ps1 -Mode staged
fi

echo "PowerShell is required to run the private materials guard." >&2
exit 1
