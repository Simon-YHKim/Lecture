    { "lesson": "lesson-03-lines-polylines", "in": "L02_SETUP", "out": "L03_BASE_PROFILE", "increment": "front-view-base-profile", "layersUsed": ["OUTLINE", "CONSTRUCTION"] },
    { "lesson": "lesson-04-curves-offset", "in": "L03_BASE_PROFILE", "out": "L04_PRIMARY_FEATURES", "increment": "circles-arcs-pocket-slot-offset", "layersUsed": ["OUTLINE", "CENTER", "CONSTRUCTION"] },
