    { "lesson": "lesson-06-placement-repetition", "in": "L05_THIRD_ANGLE_VIEWS", "out": "L06_PATTERNED_FEATURES", "increment": "mirrored-and-arrayed-features", "layersUsed": ["OUTLINE", "CENTER", "HIDDEN", "CONSTRUCTION"] },
    { "lesson": "lesson-07-object-editing", "in": "L06_PATTERNED_FEATURES", "out": "L07_GEOMETRY_FINAL", "increment": "trim-extend-projectors-fillet-chamfer-reference-scale", "layersUsed": ["OUTLINE", "CENTER", "HIDDEN", "CONSTRUCTION"] },
    { "lesson": "lesson-08-representation-reuse", "in": "L07_GEOMETRY_FINAL", "out": "L08_REPRESENTED", "increment": "hatch-block-group-title-notes", "layersUsed": ["BORDER", "TITLE", "HATCH", "OUTLINE", "CENTER", "HIDDEN"] },
